filters:
  or:
    - and:
        - file.name != "index"
        - or:
            - file.path.startsWith("1. World Almanac/World/Gods & Divines/Dead Gods/")
            - file.path.startsWith("1. World Almanac/World/Gods & Divines/Greater Gods/")
            - file.path.startsWith("1. World Almanac/World/Gods & Divines/Lesser Gods/")
            - file.path.startsWith("1. World Almanac/World/Gods & Divines/The Twins/")
formulas:
  Untitled: ""
views:
  - type: table
    name: All Gods
    filters:
      and:
        - file.name != "index"
    order:
      - file.name
